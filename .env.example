# PostgreSQL Connection
DATABASE_URL=postgresql://postgres:Admin@localhost:5432/risklens

# Frontend Firebase Configuration
NEXT_PUBLIC_FIREBASE_API_KEY=your_api_key
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=your_project.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=your_project_id
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=your_project.appspot.com
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=123456789
NEXT_PUBLIC_FIREBASE_APP_ID=1:123456789:web:abcdef

# Backend Firebase Admin Configuration
# Path to your serviceAccountKey.json (For local dev only!)
GOOGLE_APPLICATION_CREDENTIALS=./serviceAccountKey.json

# AI Configuration
GEMINI_API_KEY=your_gemini_api_key_here
AI_AUTO_ACCEPT_THRESHOLD=0.80
AI_REVIEW_THRESHOLD=0.60

# Incident Duplicate Detection
DUPLICATE_GEO_RADIUS_METERS=500
DUPLICATE_TIME_WINDOW_HOURS=72
DUPLICATE_SIMILARITY_AUTO_LINK=0.90
DUPLICATE_SIMILARITY_REVIEW=0.75
